#!/usr/bin/env python3
"""
M_mp3: Convert audio files in a directory to MP3 without deleting originals.
"""

import argparse
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path
from typing import List, Optional


SUPPORTED_EXTENSIONS = {
    ".mp3",
    ".m4a",
    ".aac",
    ".opus",
    ".ogg",
    ".flac",
    ".wav",
    ".wave",
    ".aiff",
    ".aif",
    ".webm",
    ".wma",
}


class MMp3Error(Exception):
    pass


def require_ffmpeg() -> str:
    ffmpeg = shutil.which("ffmpeg")
    if not ffmpeg:
        raise MMp3Error("ffmpeg is required. Install it with: brew install ffmpeg")
    return ffmpeg


def is_inside(path: Path, directory: Path) -> bool:
    try:
        path.relative_to(directory)
        return True
    except ValueError:
        return False


def discover_audio_files(directory: Path, recursive: bool, excluded_dir: Optional[Path]) -> List[Path]:
    iterator = directory.rglob("*") if recursive else directory.glob("*")
    files = []
    for candidate in iterator:
        if not candidate.is_file() or candidate.suffix.lower() not in SUPPORTED_EXTENSIONS:
            continue
        resolved = candidate.resolve()
        if excluded_dir and is_inside(resolved, excluded_dir):
            continue
        files.append(resolved)
    return sorted(files)


def destination_for(source: Path, source_dir: Path, output_dir: Optional[Path]) -> Path:
    if output_dir is None:
        return source.with_suffix(".mp3")
    relative = source.relative_to(source_dir).with_suffix(".mp3")
    return output_dir / relative


def convert(ffmpeg: str, source: Path, destination: Path) -> None:
    destination.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.TemporaryDirectory(prefix=".M_mp3_", dir=str(destination.parent)) as raw_temp_dir:
        temporary = Path(raw_temp_dir) / destination.name
        command = [
            ffmpeg,
            "-hide_banner",
            "-nostdin",
            "-y",
            "-i",
            str(source),
            "-map",
            "0:a:0",
            "-map_metadata",
            "0",
            "-vn",
            "-c:a",
            "libmp3lame",
            "-q:a",
            "2",
            str(temporary),
        ]
        process = subprocess.run(
            command,
            text=True,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.PIPE,
            check=False,
        )
        if process.returncode != 0:
            message = process.stderr.strip().splitlines()
            raise MMp3Error(message[-1] if message else f"ffmpeg exited with status {process.returncode}")
        temporary.replace(destination)


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="M_mp3",
        description="Convert audio files in a directory to MP3 while keeping the originals.",
    )
    parser.add_argument("directory", nargs="?", help="directory containing audio files")
    parser.add_argument("-o", "--output-dir", help="output directory; defaults to each source file's directory")
    parser.add_argument("--no-recursive", action="store_true", help="do not scan subdirectories")
    parser.add_argument("--overwrite", action="store_true", help="overwrite existing MP3 files")
    parser.add_argument("--dry-run", action="store_true", help="show planned conversions without writing files")
    parser.add_argument("--check", action="store_true", help="check whether ffmpeg is available and exit")
    return parser


def main(argv: Optional[List[str]] = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)

    if args.check:
        ffmpeg = shutil.which("ffmpeg")
        print(f"ffmpeg: {'ok - ' + ffmpeg if ffmpeg else 'missing - brew install ffmpeg'}")
        return 0 if ffmpeg else 1
    if not args.directory:
        parser.error("directory is required unless --check is used")

    try:
        source_dir = Path(args.directory).expanduser().resolve()
        if not source_dir.exists():
            raise MMp3Error(f"directory not found: {source_dir}")
        if not source_dir.is_dir():
            raise MMp3Error(f"not a directory: {source_dir}")

        output_dir = Path(args.output_dir).expanduser().resolve() if args.output_dir else None
        excluded_dir = output_dir if output_dir and is_inside(output_dir, source_dir) and output_dir != source_dir else None
        files = discover_audio_files(source_dir, recursive=not args.no_recursive, excluded_dir=excluded_dir)
        if not files:
            raise MMp3Error("no supported audio files found")

        ffmpeg = require_ffmpeg() if not args.dry_run else (shutil.which("ffmpeg") or "ffmpeg")
        counts = {"converted": 0, "skipped": 0, "planned": 0, "failed": 0}

        for source in files:
            destination = destination_for(source, source_dir, output_dir)
            if source.suffix.lower() == ".mp3":
                print(f"skip (already MP3): {source}")
                counts["skipped"] += 1
                continue
            if destination.exists() and not args.overwrite:
                print(f"skip (output exists): {destination}")
                counts["skipped"] += 1
                continue
            if args.dry_run:
                print(f"convert: {source} -> {destination}")
                counts["planned"] += 1
                continue

            print(f"convert: {source} -> {destination}")
            try:
                convert(ffmpeg, source, destination)
                counts["converted"] += 1
            except MMp3Error as exc:
                counts["failed"] += 1
                print(f"failed: {source}: {exc}", file=sys.stderr)

        print(
            "summary: "
            f"converted={counts['converted']} "
            f"skipped={counts['skipped']} "
            f"planned={counts['planned']} "
            f"failed={counts['failed']}"
        )
        return 1 if counts["failed"] else 0
    except MMp3Error as exc:
        print(f"M_mp3: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
